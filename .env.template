# =============================================================================
# Environment Template for Ricochet UI
# =============================================================================
# Placeholders (replaced at build time):
#   SCAC_URI-    -> lowercase scac prefix (e.g., "amtk-")
#   SCAC_VAR     -> uppercase scac (e.g., "AMTK")
#   MARK_LIST    -> customer marks (e.g., "AMTK,CDTX,IDTX,WDTX")
#   ENVIRONMENT. -> subdomain (empty for prod, "interop." for dev, "dr." for dr)
# =============================================================================

REACT_APP_BASE_PATH = /ricochet-ui

# API Endpoints
REACT_APP_REGISTER_URL = https://SCAC_URI-apps.ENVIRONMENT.railwaynet.net/strolr-api/ricochet/mobile/register
REACT_APP_GET_DATA_URL = https://SCAC_URI-apps.ENVIRONMENT.railwaynet.net/strolr-api/ricochet/mobile/run
REACT_APP_GET_REGISTER_STATUS_URL = https://SCAC_URI-apps.ENVIRONMENT.railwaynet.net/strolr-api/ricochet/mobile/status
REACT_APP_GET_AUTHSTATUS_URL = https://SCAC_URI-apps.ENVIRONMENT.railwaynet.net/strolr-api/ricochet/mobile/authstatus

# Customer Configuration
REACT_APP_SCAC = SCAC_VAR
REACT_APP_MARKS = MARK_LIST

# Application Settings
REACT_APP_LOG_TYPE = HTTP
REACT_APP_UPDATE_MAX_ERRORS = 10
